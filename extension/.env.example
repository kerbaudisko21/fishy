# Copy to .env.local and fill in from Firebase console > Project settings > Your apps (Web).
# Never commit .env.local.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check debug token (Firebase console > App Check > Apps > Manage debug tokens).
# The extension cannot load reCAPTCHA, so the demo build uses this. #BuildHybridAI accepts debug tokens.
VITE_APPCHECK_DEBUG_TOKEN=

# Cloud model used when Gemini Nano is not on the laptop.
VITE_CLOUD_MODEL=gemini-3.5-flash-lite

# Which Gemini API Firebase AI Logic calls for that cloud model: "developer" or "agent-platform".
# "developer" (Gemini Developer API) costs nothing on a project without billing. On a project with
# billing it needs prepaid credit, and free trial credit cannot pay for it: use "agent-platform" there.
VITE_AI_PROVIDER=developer

# Set to "true" to run on the synthetic demo company instead of live Meet/Gmail.
VITE_DEMO_MODE=true
