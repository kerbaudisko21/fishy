# Copy to .env.local. Same Firebase web app as the extension.
# Leave empty to run the pages on demo data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# reCAPTCHA Enterprise site key for App Check on the hosted pages.
VITE_RECAPTCHA_ENTERPRISE_KEY=
# Web push certificate (Firebase console > Cloud Messaging > Web configuration), for team alerts.
VITE_FCM_VAPID_KEY=
# Which Gemini API the pages' cloud model uses: developer (when not set) or agent-platform.
# Same meaning as in extension/.env.example; see the README.
VITE_AI_PROVIDER=developer
# Optional, local dev only.
VITE_APPCHECK_DEBUG_TOKEN=
