# Settings for the phone check. Copy to .env.<your-project-id> in this folder
# and fill it in. That file is never committed.
#
# The two secrets are not kept here. Set them with:
#   npx firebase-tools functions:secrets:set FISHY_TWILIO_ACCOUNT_SID
#   npx firebase-tools functions:secrets:set FISHY_TWILIO_AUTH_TOKEN

# The public address of the Hosting site, without a trailing slash.
# The phone provider and the approval page both use it.
PUBLIC_BASE_URL=https://your-project-id.web.app

# Shown on the approval page, so the approver knows who is asking.
COMPANY_NAME=
# The company's own domain. It can never be added to the known-scam list.
COMPANY_DOMAIN=

# The number calls come from, in international format.
TWILIO_FROM=

# Real calls. Both locks are closed by default.
# CALLS_ENABLED must be true AND the number must be on CALL_ALLOWLIST.
# CALL_ALLOWLIST is a comma-separated list of numbers in international format.
CALLS_ENABLED=false
CALL_ALLOWLIST=
CALLS_DAILY_CAP=20

# The web approval page for judges. A demo device: leave it off in real use.
APPROVAL_PAGE_ENABLED=false
